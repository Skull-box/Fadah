{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash .github/scripts/build.sh ${nextRelease.version} && echo ${nextRelease.version} > .release-version"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "target/Fadah-Bukkit-*.jar" }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ]
  ]
}
